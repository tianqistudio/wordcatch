<Application x:Class="WordLens.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#1C2630"/>
  <SolidColorBrush x:Key="Card" Color="#263440"/>
  <SolidColorBrush x:Key="Accent" Color="#E9B949"/>
  <Style x:Key="AppWindow" TargetType="Window"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="#FFF4D9"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Icon" Value="/Assets/wordcatch.ico"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#17212A"/><Setter Property="Foreground" Value="#FFF4D9"/><Setter Property="CaretBrush" Value="#E9B949"/><Setter Property="BorderBrush" Value="#667581"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="16"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Foreground" Value="#FFF4D9"/><Setter Property="Background" Value="#344654"/><Setter Property="MinHeight" Value="38"/><Setter Property="BorderBrush" Value="#667581"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E9B949"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E9B949"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#1C2630"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Application.Resources>
</Application>