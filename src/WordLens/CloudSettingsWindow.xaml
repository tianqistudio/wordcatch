<Window x:Class="WordLens.CloudSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="单词捕手 · 设置与关于" Width="530" Height="680" MinWidth="480" MinHeight="500" WindowStartupLocation="CenterOwner">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="软件更新" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock x:Name="InstalledVersion" Foreground="#B7C4CD" Margin="0,8,0,12"/>
  <CheckBox x:Name="AutoUpdate" Content="自动检测更新（每 6 小时最多一次）" Foreground="White" Margin="0,0,0,12"/>
  <TextBlock Text="检测来源" Margin="0,0,0,6"/>
  <ComboBox x:Name="UpdateSourceChoice" SelectedIndex="0" Padding="8" AutomationProperties.Name="更新检测来源"><ComboBoxItem Content="自动 · 比较网站与 GitHub"/><ComboBoxItem Content="tianqistudio.com"/><ComboBoxItem Content="GitHub"/></ComboBox>
  <TextBlock Text="仅检查版本，不上传查词内容，不自动下载或安装。" Foreground="#B7C4CD" Margin="0,10,0,12"/>
  <WrapPanel><Button x:Name="CheckUpdate" Content="检查更新" Click="CheckUpdateNow"/><Button x:Name="DownloadUpdate" Content="查看新版" Click="OpenUpdate" Visibility="Collapsed"/></WrapPanel>
  <TextBlock x:Name="UpdateStatus" Foreground="#E9B949" Margin="0,10,0,26"/>
  <TextBlock Text="云端备用翻译" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="本地词典未收录或选中短句时，使用云端备用翻译。" Margin="0,10,0,18" Foreground="#CCCCCC"/>
  <CheckBox x:Name="Enabled" Content="启用云端备用翻译" Foreground="White" Margin="0,0,0,20"/>
  <TextBlock Text="密钥" Margin="0,0,0,6"/>
  <PasswordBox x:Name="ApiKey" Background="#17212A" Foreground="#FFF4D9" CaretBrush="#E9B949" BorderBrush="#667581" Padding="10" AutomationProperties.Name="Azure Translator 密钥"/>
  <TextBlock Text="区域（如 eastasia；全球单服务资源可留空）" Margin="0,16,0,6"/>
  <TextBox x:Name="Region" MaxLength="64" AutomationProperties.Name="Azure 资源区域"/>
  <TextBlock Text="仅发送当前待翻译文字至微软，不上传截图。密钥使用 Windows 当前用户加密保存。费用与额度由你的 Azure 订阅决定。" Foreground="#CCCCCC" Margin="0,18,0,16"/>
  <TextBlock x:Name="Message" Foreground="#B9DFFF" MinHeight="45"/>
  <Border Background="{StaticResource Card}" CornerRadius="8" Padding="14" Margin="0,0,0,18"><StackPanel><TextBlock Text="单词捕手 · WordCatch 0.4.0" FontWeight="SemiBold"/><TextBlock Text="本地词库：770,611 条，包含短语及专名。&#10;768,739 条有中文释义；本地不提供整句机器翻译。" Foreground="#B7C4CD" Margin="0,8,0,0"/><TextBlock Text="选区与 OCR 在本地处理，不保存截图或查询历史。" Foreground="#B7C4CD" Margin="0,8,0,0"/></StackPanel></Border><WrapPanel HorizontalAlignment="Right"><Button x:Name="Test" Content="测试连接" Click="TestConnection" ToolTip="向 Azure 发送固定测试文字 Hello，不发送屏幕内容。"/><Button Content="保存" Click="Save"/><Button Content="取消" Click="Cancel" Margin="0"/></WrapPanel>
 </StackPanel></ScrollViewer>
</Window>
