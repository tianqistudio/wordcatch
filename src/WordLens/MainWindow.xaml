<Window x:Class="WordLens.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="单词捕手 · WordCatch" Width="590" Height="610" MinWidth="480" MinHeight="560" WindowStartupLocation="CenterScreen">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <DockPanel Margin="0,0,0,26"><Image Source="Assets/wordcatch.png" Width="64" Height="64" DockPanel.Dock="Left" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="单词捕手" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="WordCatch" Foreground="#B7C4CD" FontSize="14" Margin="0,3,0,0"/></StackPanel></DockPanel>
  <Button x:Name="UpdateNotice" Visibility="Collapsed" Click="OpenUpdate" Style="{StaticResource PrimaryButton}" Margin="0,0,0,14" HorizontalAlignment="Left"/><TextBlock Text="选中就查，指向也能查。" FontSize="18" Margin="0,0,0,18"/>
  <TextBlock Text="输入单词或句子" Foreground="#B7C4CD" Margin="0,0,0,8"/>
  <DockPanel><Button x:Name="LookupButton" Content="查询" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="ManualLookup" Margin="10,0,0,0" IsDefault="True" IsEnabled="False"/><TextBox x:Name="Query" AutomationProperties.Name="输入单词或句子" MaxLength="2000" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"/></DockPanel>
  <TextBlock x:Name="Status" Text="正在准备本地识别与词典…" Foreground="#E9B949" Margin="0,10,0,22"/>
  <Border Background="{StaticResource Card}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="屏幕取词" Foreground="#B7C4CD"/><DockPanel Margin="0,10,0,8"><Button Content="更换" AutomationProperties.Name="更换取词快捷键" DockPanel.Dock="Right" Click="ChangeHotkey" Margin="10,0,0,0"/><TextBlock x:Name="HotkeyLabel" FontSize="20" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="HotkeyStatus" Foreground="#B7C4CD"/><TextBlock Text="先读取选区；无法读取时，识别鼠标指向的文字。" Foreground="#B7C4CD" Margin="0,10,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
 <DockPanel Grid.Row="1" Margin="0,20,0,0"><Button Content="收起" ToolTip="收起到通知区域，快捷键仍可使用" DockPanel.Dock="Right" Click="HideWindow" Margin="8,0,0,0"/><Button Content="退出" DockPanel.Dock="Right" Click="ExitApp" Margin="8,0,0,0"/><Button Content="设置与关于" Click="OpenCloudSettings" HorizontalAlignment="Left"/></DockPanel>
 </Grid>
</Window>