<UserControl x:Class="WordLens.ResultCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><TextBlock x:Name="Kind" Text="单词释义" DockPanel.Dock="Right" Foreground="#E9B949"/><TextBlock x:Name="Origin" Text="输入文字" Foreground="#B7C4CD"/></DockPanel>
  <DockPanel Grid.Row="1"><Button Content="重查" Style="{StaticResource PrimaryButton}" Click="QueryAgain" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Word" FontSize="21" FontWeight="SemiBold" AutomationProperties.Name="原文，可修改后按 Enter 重查" MaxLength="2000" MaxHeight="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" KeyDown="WordKeyDown" TextChanged="WordChanged"/></DockPanel>
  <TextBlock Grid.Row="2" x:Name="Phonetic" Foreground="#E9B949" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <StackPanel Grid.Row="3"><TextBlock x:Name="State" Text="正在查询…" Foreground="#B7C4CD" Margin="0,8,0,10"/><ProgressBar x:Name="Busy" IsIndeterminate="True" Height="2" Foreground="#E9B949" Background="#344654" Visibility="Collapsed" Margin="0,0,0,10"/></StackPanel>
  <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Definition" FontSize="17" LineHeight="28"/></ScrollViewer>
  <Grid Grid.Row="5" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Source" Text="本地词典 · ECDICT" Foreground="#B7C4CD" FontSize="12" Margin="0,0,0,10"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制原文" Click="CopyWord"/><Button Content="云端翻译" Click="CloudLookup" Margin="0"/></StackPanel></Grid>
 </Grid>
</UserControl>