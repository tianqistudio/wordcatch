<Window x:Class="WordLens.ResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="单词捕手 · 查询结果" Width="460" Height="460" MinWidth="380" MinHeight="440" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="CanResizeWithGrip">
 <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="Cards">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="ClipboardColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="ClipboardRow" Height="0"/></Grid.RowDefinitions>
   <ContentControl x:Name="PrimaryHost"/>
   <Border x:Name="ClipboardBorder" Grid.Column="1" BorderBrush="#344654" BorderThickness="1,0,0,0" Visibility="Collapsed"><ContentControl x:Name="ClipboardHost"/></Border>
  </Grid>
 </ScrollViewer>
</Window>
